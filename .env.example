NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF5aXFkd3JqdGdkem9jb2ZmenZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI4ODUwOTYsImV4cCI6MjA5ODQ2MTA5Nn0.UMeDptWDjGshwscCX4E7vCOzboMkBtl1V8uWsjaiS8E

# Server-only. Never expose to the client. Get it from the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── School identity (branding) ───────────────────────────────────────────────
# Optional. With none of these set the app builds as
# "The Suman Nirmal Minda School, Ahmedabad" (defaults live in src/lib/school.ts).
# NEXT_PUBLIC_* are inlined at build time — change them and rebuild/redeploy.
# NEXT_PUBLIC_SCHOOL_NAME=The Suman Nirmal Minda School
# NEXT_PUBLIC_SCHOOL_PLACE=Ahmedabad
# NEXT_PUBLIC_SCHOOL_SHORT_NAME=Suman Nirmal Minda School
# NEXT_PUBLIC_SCHOOL_MONOGRAM=SM
# NEXT_PUBLIC_SCHOOL_LOGO=/brand/school-logo.png
# NEXT_PUBLIC_SCHOOL_LOGIN_IMAGE=
# NEXT_PUBLIC_SCHOOL_LOGIN_VIDEO_ID=dX2RNaONA8A

# School transport is held back behind a "Coming soon" screen until this is "true".
NEXT_PUBLIC_TRANSPORT_ENABLED=false
